{
  "manifest_version": 3,
  "name": "X Video Gate",
  "version": "1.4.1",
  "description": "Blocks videos on X/Twitter from accounts you don't follow. Tap to play a single video in its own tab — no feed, no scrolling.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "https://mobile.x.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "https://mobile.x.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.twitter.com/*", "https://mobile.x.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "X Video Gate" },
  "icons": { "48": "icon48.png", "128": "icon128.png" }
}
